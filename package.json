{
  "name": "yaman-alsheabe-production-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready personal portfolio for YMAN ALSHEABE with Next.js 15, Tailwind CSS, shadcn/ui components, Docker, Nginx, and DevSecOps CI.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "serve out --listen 3000",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t yaman-portfolio:local .",
    "docker:run": "docker run --rm -p 8080:8080 yaman-portfolio:local"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.11.0",
    "next": "15.5.15",
    "next-themes": "^0.4.6",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "15.5.15",
    "serve": "^14.2.5",
    "tailwindcss": "^4.2.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
